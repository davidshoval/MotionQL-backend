# Copy to .env for local development. Never commit .env or any key.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=xquery

# The website, for e-mail links and CORS.
WEB_URL=http://localhost:3000
# WEB_ORIGINS=http://localhost:3000,https://xquery.io
# COOKIE_DOMAIN=.xquery.io
# lax when site and API share a domain; none when they are on separate hosts such as *.onrender.com.
# COOKIE_SAME_SITE=lax

# Ed25519 key that signs license keys and the manifest. `npm run keygen:dev` makes a development one.
# Production: the key from the app's `npm run license -- keygen`, kept only in the host's secret store.
LICENSE_SIGNING_KEY_FILE=.license-dev/xquery-license-private.pem
# LICENSE_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# LICENSE_SIGNING_KEY_PASSPHRASE=

# console = print e-mails to the log; resend = send them.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM="Xquery <hello@xquery.io>"

# TURNSTILE_SECRET=
# RELEASES_REPO=davidshoval/Xquery.io-releases
# GITHUB_TOKEN=
# TRUST_PROXY=true
