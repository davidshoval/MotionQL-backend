# Copy to .env for local development. Never commit .env or any key.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=motionql

# The website, for e-mail links and CORS.
WEB_URL=http://localhost:3000
# WEB_ORIGINS=http://localhost:3000,https://motionql.com,https://www.motionql.com
# COOKIE_DOMAIN=.motionql.com
# lax when site and API share a domain; none when they are on separate hosts such as *.onrender.com.
# COOKIE_SAME_SITE=lax

# Ed25519 key that signs license keys and the manifest. `npm run keygen:dev` makes a development one.
# Production: the key from the app's `npm run license -- keygen`, kept only in the host's secret store.
LICENSE_SIGNING_KEY_FILE=.license-dev/motionql-license-private.pem
# LICENSE_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# LICENSE_SIGNING_KEY_PASSPHRASE=

# console = print e-mails to the log; resend = send them.
# console (prints e-mails to the log), smtp (e.g. Gmail + app password) or resend
EMAIL_PROVIDER=console
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# RESEND_API_KEY=
# EMAIL_FROM="MotionQL <hello@motionql.com>"

# STAFF_EMAILS=you@example.com
# TURNSTILE_SECRET=
# RELEASES_REPO=davidshoval/motionql-releases
# GITHUB_TOKEN=
# TRUST_PROXY=true
